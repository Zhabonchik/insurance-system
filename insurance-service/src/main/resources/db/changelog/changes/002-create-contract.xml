<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="002-create-contract" author="Zhabonchik">
    <createTable tableName="contract">
      <column name="id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="application_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="contract_number" type="VARCHAR(100)">
        <constraints nullable="false"/>
      </column>
      <column name="status" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <!-- 1:1 relationship backstop: one contract per application. -->
    <addUniqueConstraint tableName="contract"
      columnNames="application_id"
      constraintName="uq_contract_application_id"/>

    <addUniqueConstraint tableName="contract"
      columnNames="contract_number"
      constraintName="uq_contract_contract_number"/>

    <addForeignKeyConstraint baseTableName="contract"
      baseColumnNames="application_id"
      referencedTableName="application"
      referencedColumnNames="id"
      constraintName="fk_contract_application"/>

    <sql>
      <![CDATA[
        ALTER TABLE contract
        ADD CONSTRAINT chk_contract_status
        CHECK (status IN ('CREATED', 'REGISTERED'));
      ]]>
    </sql>

    <rollback>
      <dropTable tableName="contract"/>
    </rollback>
  </changeSet>
</databaseChangeLog>
