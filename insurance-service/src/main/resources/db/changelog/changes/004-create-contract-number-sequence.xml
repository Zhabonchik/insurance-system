<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="004-create-contract-number-sequence" author="Zhabonchik">
    <createTable tableName="contract_number_sequence">
      <column name="id" type="INTEGER">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="next_value" type="BIGINT">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <insert tableName="contract_number_sequence">
      <column name="id" valueNumeric="1"/>
      <column name="next_value" valueNumeric="0"/>
    </insert>

    <rollback>
      <delete tableName="contract_number_sequence">
        <where>id = 1</where>
      </delete>
      <dropTable tableName="contract_number_sequence"/>
    </rollback>
  </changeSet>
</databaseChangeLog>
